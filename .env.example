AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
# Supplementary group used by Airflow to access the mounted Docker socket.
DOCKER_GID=1001
# Required for the LocalStack services used by this stack. Copy your token into .env.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_IMAGE=localstack/localstack-pro:2026.3.0
DEPLOYMENT_ENV=local
PROJECT_NAME=smart_meter
KINESIS_STREAM_NAME=local_smart_meter_events_kds
PRICING_STREAM_NAME=local_smart_meter_prices_kds
RAW_BUCKET=local-smart-meter-raw-s3
CURATED_BUCKET=local-smart-meter-curated-s3
GLUE_RUNNER_IMAGE=local-smart-meter-glue:5
GLUE_LOCAL_PARALLELISM=4
LOCAL_BOOKMARK_TABLE=local_smart_meter_bookmarks_ddb
WAREHOUSE_SECRET_ID=local_smart_meter_warehouse_sm
EVENTS_PER_SECOND=5
METER_COUNT=100
PRICING_REFRESH_SECONDS=300
MOONCAKE_PASSWORD=mooncake
AIRFLOW_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_PASSWORD=admin
